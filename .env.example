# Copy to .env.local (never commit it) and fill in.

# Sandbox (default): https://dev.partners.cbgc.io with a pk_test_ key; nothing is billed.
# Production: https://partners.cbgc.io with a pk_live_ key.
CBC_BASE_URL=https://dev.partners.cbgc.io

# Your API key. Server-side only: never prefix it with NEXT_PUBLIC_.
# Get a sandbox key at https://join.cbgc.io/sandbox/
CBC_API_KEY=

# Your webhook signing secret (whsec_...), used to verify X-Partner-Signature.
CBC_WEBHOOK_SECRET=

# Optional: where the local JSON store lives (default .data/cbc-store.json).
# CBC_STORE_PATH=.data/cbc-store.json
